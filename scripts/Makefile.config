src := $(srcroot)/$(obj)

PHONY := $(obj)/
$(obj)/:

subdir-y :=
subdir- :=
obj-y :=
obj- :=

include $(srcroot)/scripts/Makefile.include
include $(src)/Makefile

subdir-config := $(addprefix $(obj)/, $(filter-out test, $(subdir-) $(subdir-y)))
test-config := $(addprefix $(obj)/, $(filter test, $(subdir-)))

real-config := $(patsubst %.o, $(obj)/%.o, $(obj-))
real-config += $(subdir-config) $(test-config)

if_cfg_enabled = $(if $(shell grep -e '^$(target-cfg)=y\s*' $(BUILD_CONFIG)), \
	$(file >>$(configdir)/autoconf.h,#define $(target-cfg) 1) \
	$(file >>$(configdir)/auto.conf,$(target-cfg)=y), \
	$(file >>$(configdir)/auto.conf,# $(target-cfg) is not set))

PHONY += FORCE
FORCE:

$(subdir-config): target-cfg = $(call config_name, $@)
$(test-config): target-cfg = $(call config_name, $(patsubst %/test, %, $@))_TEST
$(obj)/%.o: target-cfg = $(call to_upper, $(patsubst $(obj)/%.o, CONFIG_%, $@))

$(subdir-y):;

$(subdir-): FORCE
	$(call if_cfg_enabled, $(target-cfg))

$(subdir-config): $(obj)/%: % FORCE
	$(MAKE) $(config)=$@

$(test-config): FORCE
	$(call if_cfg_enabled, $(target-cfg))

$(obj)/%.o: $(obj)/%.c FORCE
	$(call if_cfg_enabled, $(target-cfg))

$(obj)/: $(real-config) FORCE;

.PHONY: $(PHONY)
